DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tastyboard?schema=public
JWT_SECRET=troque-por-uma-chave-com-pelo-menos-32-caracteres
CORS_ORIGIN=http://localhost:3000
PORT=3001
NODE_ENV=development

# Upload de imagens/vídeos das receitas (opcional em dev: sem essas variáveis
# o servidor sobe normalmente, mas os endpoints de mídia retornam erro 500)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# E-mail de redefinição de senha (opcional em dev: sem RESEND_API_KEY o link
# de redefinição é apenas logado no console do backend, em vez de enviado por e-mail)
# RESEND_API_KEY=
RESEND_FROM_EMAIL=TastyBoard <onboarding@resend.dev>
FRONTEND_URL=http://localhost:3000
